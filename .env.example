# Public authentication bridge
RUNPLANE_AUTH_ENABLED=false
RUNPLANE_AUTH_URL=

# Controlled runtime bridge
# Server-only. Never expose as NEXT_PUBLIC_*.
WHALEZ_RUNTIME_BRIDGE_ENABLED=false
WHALEZ_ORCHESTRATOR_URL=https://orchestrator.deltaalpha-trade-pro.com
WHALEZ_ORCHESTRATOR_API_KEY=

# Controlled testnet proof source
WHALEZ_RUNTIME_TESTNET_SOURCE_ACCOUNT=whalezchain-testnet://founder/internal-alpha

# Live NGN corridor (production activation remains fail-closed until configured)
LIVE_NGN_CORRIDOR_ENABLED=false
LIVE_NGN_CORRIDOR_POLICY_ID=
LIVE_NGN_MIN_VERIFICATION_LEVEL=V1
LIVE_NGN_MAX_AMOUNT_KOBO=100000000
LIVE_NGN_APPROVAL_MODE=manual
WHALEZ_RUNTIME_SETTLEMENT_URL=
WHALEZ_RUNTIME_SETTLEMENT_TOKEN=
PAYSTACK_SECRET_KEY=
PAYSTACK_LIVE_MODE=false
PAYSTACK_REQUIRE_LIVE_DOMAIN=true

# Live market-data read bridge (server-only)
WHALEZ_RUNTIME_MARKET_DATA_URL=
WHALEZ_RUNTIME_MARKET_DATA_TOKEN=

# Optional existing public/demo controls
AUTH_DEMO_MODE=false

# Never place secrets in this file. Use the deployment secret store.
