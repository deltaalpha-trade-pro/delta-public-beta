# Public beta auth bridge
# Leave demo mode enabled for preview deployments unless the backend auth
# contract is explicitly documented and verified for this repo.
AUTH_DEMO_MODE=true
# Required only when AUTH_DEMO_MODE=false
NEXT_PUBLIC_API_URL=http://127.0.0.1:3004

# Runtime mode flags
WHALEZ_MODE=PUBLIC
EMAIL_PROVIDER=disabled
WHALEZ_AUDIT_LOG=0

# Local-only Termux/Android smoke flags
# Do not set these on Vercel preview deployments.
NEXT_DISABLE_SWC=0
NEXT_FORCE_WASM=1
